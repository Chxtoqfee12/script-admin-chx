-- ===== หน้า Float =====
local Tab = Window:CreateTab({
	Name = "การควบคุลอยตัว",
	Icon = "airplanemode_active",
	ImageSource = "Material",
	ShowTitle = true
})

-- ===== ตัวแปร =====
local Floating = false
local FloatHeight = 5
local FloatSpeed = 10
local AutoReset = false
local Hotkey = Enum.KeyCode.F -- ปุ่มลอยตัว

local player = game:GetService("Players").LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")

-- ===== ฟังก์ชัน =====
local function enableFloat()
	if Floating then return end
	Floating = true
	local floatY = root.Position.Y
	local floatLoop
	floatLoop = RunService.Heartbeat:Connect(function(dt)
		if not Floating then floatLoop:Disconnect() return end
		local targetY = floatY + FloatHeight
		local currentY = root.Position.Y
		local diff = targetY - currentY
		root.Velocity = Vector3.new(0, diff * FloatSpeed * dt, 0)
	end)
end

local function disableFloat()
	Floating = false
	root.Velocity = Vector3.new(0,0,0)
	if AutoReset then
		root.CFrame = CFrame.new(root.Position.X, root.Position.Y, root.Position.Z)
	end
end

-- ===== UI =====
Tab:CreateToggle({
	Name = "เปิด/ปิด ลอยตัว",
	CurrentValue = false,
	Callback = function(val)
		if val then
			enableFloat()
		else
			disableFloat()
		end
	end
})

Tab:CreateSlider({
	Name = "ความสูงของการลอยตัว",
	Range = {1, 20},
	Increment = 1,
	CurrentValue = FloatHeight,
	Callback = function(val)
		FloatHeight = val
