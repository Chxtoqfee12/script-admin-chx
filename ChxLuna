	Callback = function(val)
		FloatSpeed = val
	end
})

Tab:CreateToggle({
	Name = "รีเซ็ตอัตโนมัติเมื่อปิดลอยตัว",
	CurrentValue = AutoReset,
	Callback = function(val)
		AutoReset = val
	end
})

Tab:CreateInput({
	Name = "ตั้งปุ่มลอยตัว (F)",
	PlaceholderText = "กดปุ่มที่ต้องการ",
	CurrentValue = "F",
	Callback = function(val)
		local key = val:upper()
		local success, code = pcall(function()
			return Enum.KeyCode[key]
		end)
		if success and code then
			Hotkey = code
		else
			print("ปุ่มไม่ถูกต้อง")
		end
	end
})

-- ===== ฟังชัน Hotkey =====
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Hotkey then
		if Floating then
			disableFloat()
		else
			enableFloat()
		end
	end
end)
